# 1. Correct File Reading
data <- read.table("GSE52778_All_Sample_FPKM_Matrix (1).txt",
header = TRUE,
sep = "",
row.names = 1,
check.names = FALSE)
# 2. Check Dimensions (यहाँ Samples 0 से ज़्यादा दिखने चाहिए)
print(paste("Total Genes:", nrow(data)))
print(paste("Total Samples:", ncol(data)))
# 3. Numeric Data Conversion & Normalization
numeric_data <- as.matrix(sapply(data, as.numeric))
rownames(numeric_data) <- rownames(data)
log_data <- log2(numeric_data + 1)
# 4. Extract Top 25 Variable Genes
gene_vars <- apply(log_data, 1, var, na.rm = TRUE)
top_25_genes <- head(order(gene_vars, decreasing = TRUE, na.last = NA), 25)
matrix_top25 <- log_data[top_25_genes, ]
# 5. Plot Heatmap
heatmap(matrix_top25,
main = "Top 25 Highly Expressed Genes (GSE52778)",
col = heat.colors(256),
margins = c(10, 8))
# 1. Load Data
data <- read.table("GSE52778_All_Sample_FPKM_Matrix (1).txt",
header = TRUE,
sep = "",
row.names = 1,
check.names = FALSE)
# 2. Clean and Convert to Numeric
numeric_data <- as.matrix(data)
class(numeric_data) <- "numeric"
numeric_data[is.na(numeric_data)] <- 0
# 3. Log2 Transformation
log_data <- log2(numeric_data + 1)
# 4. Extract Top 25 Genes
gene_vars <- apply(log_data, 1, var, na.rm = TRUE)
top_25_genes <- head(order(gene_vars, decreasing = TRUE), 25)
matrix_top25 <- log_data[top_25_genes, ]
# 5. Filter out zero/NA rows
matrix_top25 <- matrix_top25[complete.cases(matrix_top25), ]
# 6. Plot Heatmap
heatmap(matrix_top25,
main = "Top 25 Highly Expressed Genes (GSE52778)",
col = heat.colors(256),
margins = c(10, 8))
# 7. Save CSV File
write.csv(matrix_top25, file = "GSE52778_Top25_Genes.csv")
print("SUCCESS! Heatmap Created and CSV Saved.")
# 1. Calculate Mean Expression and Log2 Fold Change (LFC)
# Sample Columns ko do groups me divide kar rahe hain
control_means <- rowMeans(log_data[, 1:20])
treatment_means <- rowMeans(log_data[, 21:40])
log2FoldChange <- treatment_means - control_means
# 2. Simple P-value Calculation (t-test per gene)
p_values <- apply(log_data, 1, function(row) {
t.test(row[1:20], row[21:40])$p.value
})
# 3. Create Dataframe for Volcano Plot
volcano_df <- data.frame(
log2FC = log2FoldChange,
pvalue = p_values,
negLogP = -log10(p_values)
)
# 4. Color Assignment (Significance threshold)
volcano_df$color <- "grey" # Normal genes
volcano_df$color[volcano_df$log2FC > 1 & volcano_df$pvalue < 0.05] <- "red"   # Up-regulated
volcano_df$color[volcano_df$log2FC < -1 & volcano_df$pvalue < 0.05] <- "blue" # Down-regulated
# 5. Plot Volcano Plot
plot(volcano_df$log2FC, volcano_df$negLogP,
col = volcano_df$color,
pch = 20,
main = "Volcano Plot (GSE52778 Analysis)",
xlab = "Log2 Fold Change",
ylab = "-Log10 P-value")
# Significance Lines (Thresholds)
abline(h = -log10(0.05), col = "black", lty = 2) # P-value threshold
abline(v = c(-1, 1), col = "black", lty = 2)     # Fold Change threshold
legend("topright", legend=c("Up-regulated", "Down-regulated", "Not Significant"),
col=c("red", "blue", "grey"), pch=20)
print("Volcano Plot Created Successfully!")
# Significant Genes Save Karein
write.csv(volcano_df, file = "GSE52778_Volcano_Data.csv")
print("Volcano Data CSV Saved Successfully!")
